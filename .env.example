# ── Server ──────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Database (PostgreSQL) ────────────────────────────────────────
DEV_DB_USERNAME=postgres
DEV_DB_PASSWORD=your_dev_password
DEV_DB_NAME=boilerplate_dev
DEV_DB_HOST=localhost
DEV_DB_PORT=5432
DEV_DB_DIALECT=postgres

TEST_DB_USERNAME=postgres
TEST_DB_PASSWORD=your_test_password
TEST_DB_NAME=boilerplate_test
TEST_DB_HOST=localhost
TEST_DB_PORT=5432
TEST_DB_DIALECT=postgres

PROD_DB_USERNAME=postgres
PROD_DB_PASSWORD=your_prod_password
PROD_DB_NAME=boilerplate_prod
PROD_DB_HOST=localhost
PROD_DB_PORT=5432
PROD_DB_DIALECT=postgres

# ── JWT ─────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_64_char_random_hex_secret
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=7d

# ── Session ─────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_32_char_random_hex_secret

# ── CORS ─────────────────────────────────────────────────────────
# Pisahkan dengan koma jika lebih dari satu: http://localhost:3000,https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173

# ── Redis (opsional, untuk caching CASL) ─────────────────────────
REDIS_URL=redis://localhost:6379

# ── Kafka (opsional) ─────────────────────────────────────────────
KAFKA_ENABLE=false
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=backend-boilerplate

# ── Frontend URL (untuk reset password link) ─────────────────────
FRONTEND_URL=http://localhost:5173

# ── App ───────────────────────────────────────────────────────────
APP_NAME=Backend Boilerplate

# ── Brute Force Protection ────────────────────────────────────────
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
LOGIN_LOCKOUT_SECONDS=1800
